PORT=3000

# REQUIRED: Secret path segment for the admin UI (e.g. /app/<this-value>)
# Generate a strong random value: openssl rand -hex 24
APP_SECRET_PATH=change_me_to_a_strong_random_secret

# Supabase Configuration
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# REQUIRED: AES-256-GCM encryption key for Google OAuth tokens and WhatsApp session data
# Generate a strong random value: openssl rand -hex 32
DATA_ENCRYPTION_KEY=change_me_to_a_64_char_hex_string

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Groq LLM Configuration
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant

<!-- Admin Side Drawer Backdrop (for mobile screens) -->
<div id="adminSidebarBackdrop" class="admin-sidebar-backdrop" onclick="toggleAdminSidebar(false)"></div>

<!-- Admin Side Drawer Panel -->
<aside id="adminSidebar" class="admin-sidebar" aria-label="Admin Navigation Drawer">
  <!-- Drawer Header -->
  <div class="sidebar-header">
    <a href="/admin/dashboard" class="sidebar-brand">
      <div style="width: 28px; height: 28px; background: #09090b; color: white; border-radius: 6px; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 0.85rem;">
        LP
      </div>
      <span>LeadPush <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); background: #f4f4f5; padding: 0.15rem 0.45rem; border-radius: 4px;">Admin</span></span>
    </a>
    <button type="button" class="sidebar-close-btn" onclick="toggleAdminSidebar(false)" aria-label="Close Navigation Menu" title="Close Sidebar">
      <!-- Side Drawer Collapse Icon -->
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect width="18" height="18" x="3" y="3" rx="2"></rect>
        <line x1="9" y1="3" x2="9" y2="21"></line>
        <path d="m14 9-3 3 3 3"></path>
      </svg>
    </button>
  </div>

  <!-- Navigation Links -->
  <nav class="sidebar-nav">
    <a href="/admin/dashboard" class="sidebar-link <%= (typeof activeNav !== 'undefined' && activeNav === 'admin_dashboard') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="7" height="7"></rect>
        <rect x="14" y="3" width="7" height="7"></rect>
        <rect x="14" y="14" width="7" height="7"></rect>
        <rect x="3" y="14" width="7" height="7"></rect>
      </svg>
      <span>Overview</span>
    </a>

    <a href="/admin/leads" class="sidebar-link <%= (typeof activeNav !== 'undefined' && activeNav === 'admin_leads') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="9" cy="7" r="4"></circle>
        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
        <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
      </svg>
      <span>All Leads</span>
    </a>

    <div class="sidebar-section-title">Management</div>

    <a href="/app/<%= appSecret %>/channels" class="sidebar-link <%= (typeof activeNav !== 'undefined' && activeNav === 'channels') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect>
        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
      </svg>
      <span>Channels</span>
    </a>

    <a href="/admin/operators" class="sidebar-link <%= (typeof activeNav !== 'undefined' && activeNav === 'operators') ? 'active' : '' %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
        <circle cx="8.5" cy="7" r="4"></circle>
        <line x1="20" y1="8" x2="20" y2="14"></line>
        <line x1="23" y1="11" x2="17" y2="11"></line>
      </svg>
      <span>Operators</span>
    </a>
  </nav>

  <!-- Drawer Footer with Logout -->
  <div class="sidebar-footer">
    <div style="display: flex; align-items: center; gap: 0.6rem; margin-bottom: 0.5rem; padding: 0 0.25rem;">
      <div style="width: 32px; height: 32px; border-radius: 50%; background: #09090b; color: #ffffff; display: flex; align-items: center; justify-content: center; font-size: 0.8125rem; font-weight: 600;">
        <%= (typeof user !== 'undefined' && user && user.name) ? user.name.charAt(0).toUpperCase() : 'A' %>
      </div>
      <div style="overflow: hidden;">
        <div style="font-size: 0.8125rem; font-weight: 600; color: #09090b; white-space: nowrap; text-overflow: ellipsis; overflow: hidden;">
          <%= (typeof user !== 'undefined' && user && user.name) ? user.name : 'Super Admin' %>
        </div>
        <div style="font-size: 0.75rem; color: var(--text-muted);">
          Administrator
        </div>
      </div>
    </div>

    <form action="/logout" method="POST" style="margin: 0;">
      <button type="submit" class="sidebar-logout-btn">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
          <polyline points="16 17 21 12 16 7"></polyline>
          <line x1="21" y1="12" x2="9" y2="12"></line>
        </svg>
        Logout
      </button>
    </form>
  </div>
</aside>

<script>
  function toggleAdminSidebar(force) {
    const isDesktop = window.innerWidth >= 1024;
    const sidebar = document.getElementById('adminSidebar');
    const backdrop = document.getElementById('adminSidebarBackdrop');

    if (isDesktop) {
      if (force === undefined) {
        document.body.classList.toggle('sidebar-closed');
      } else if (force) {
        document.body.classList.remove('sidebar-closed');
      } else {
        document.body.classList.add('sidebar-closed');
      }
    } else {
      if (!sidebar || !backdrop) return;
      if (force === undefined) {
        const isOpen = sidebar.classList.contains('open');
        sidebar.classList.toggle('open', !isOpen);
        backdrop.classList.toggle('open', !isOpen);
        document.body.style.overflow = !isOpen ? 'hidden' : '';
      } else if (force) {
        sidebar.classList.add('open');
        backdrop.classList.add('open');
        document.body.style.overflow = 'hidden';
      } else {
        sidebar.classList.remove('open');
        backdrop.classList.remove('open');
        document.body.style.overflow = '';
      }
    }
  }

  // Close sidebar on escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      toggleAdminSidebar(false);
    }
  });
</script>

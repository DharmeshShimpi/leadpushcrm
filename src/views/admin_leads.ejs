<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= appTitle %> - All Leads</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/admin_sidebar') %>

  <div class="app-container">
    <main class="main-content admin-page-container">
      <!-- Top Action Bar -->
      <div class="admin-header-bar">
        <div class="admin-header-left">
          <button type="button" class="sidebar-toggle-btn" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation Drawer" title="Toggle Sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <line x1="9" y1="3" x2="9" y2="21"></line>
              <path d="m14 9 3 3-3 3"></path>
            </svg>
          </button>
          <div>
            <h1 class="admin-title">All Leads</h1>
            <p class="admin-subtitle">
              Total <%= total %> lead(s) captured across all communication channels.
            </p>
          </div>
        </div>

        <a href="/admin/dashboard" class="btn" style="background: #ffffff; color: var(--text-muted); border: 1px solid var(--border-color); padding: 0.5rem 0.9rem; font-size: 0.8125rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); display: inline-flex; align-items: center; gap: 0.35rem;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Overview
        </a>
      </div>

      <!-- Leads Table Container -->
      <div class="admin-table-container">
        <% if (leads && leads.length > 0) { %>
          <div style="overflow-x: auto; -webkit-overflow-scrolling: touch;">
            <table class="admin-table">
              <thead>
                <tr>
                  <th>Lead Details</th>
                  <th>Channel</th>
                  <th>Status</th>
                  <th>Conversion</th>
                  <th>Last Activity</th>
                  <th style="text-align: right;">Action</th>
                </tr>
              </thead>
              <tbody>
                <% leads.forEach(lead => { %>
                  <tr>
                    <td>
                      <div style="display: flex; flex-direction: column; gap: 0.2rem;">
                        <span style="font-weight: 600; color: #09090b; font-size: 0.9375rem;">
                          <%= lead.customer_name %>
                        </span>
                        <span style="font-size: 0.78125rem; color: var(--text-muted);">
                          <%= lead.display_phone || lead.whatsapp_jid || lead.lead_identity %>
                        </span>
                      </div>
                    </td>
                    <td>
                      <span style="display: inline-flex; align-items: center; background: var(--subtle-bg); padding: 0.25rem 0.55rem; border-radius: 6px; font-size: 0.78125rem; font-weight: 500; color: #09090b;">
                        <%= lead.channel_name %>
                      </span>
                    </td>
                    <td>
                      <span class="status-pill status-<%= lead.status %>">
                        <span class="status-dot"></span>
                        <%= lead.status ? lead.status.replace('_', ' ') : 'Not Contacted' %>
                      </span>
                    </td>
                    <td>
                      <span class="score-pill score-<%= (lead.conversion_score || 'Warm').toLowerCase() %>">
                        <% if (lead.conversion_score === 'Hot') { %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 3.5z"></path></svg> Hot
                        <% } else if (lead.conversion_score === 'Cold') { %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="2" x2="12" y2="22"></line><line x1="20" y1="17" x2="4" y2="7"></line><line x1="20" y1="7" x2="4" y2="7"></line></svg> Cold
                        <% } else { %>
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg> Warm
                        <% } %>
                      </span>
                    </td>
                    <td>
                      <span style="font-size: 0.8125rem; color: var(--text-muted); white-space: nowrap;">
                        <%= lead.readable_last_activity %>
                      </span>
                    </td>
                    <td style="text-align: right;">
                      <a href="/app/<%= appSecret %>/leads/<%= lead.id %>" class="btn" style="background: var(--accent-blue-light); color: var(--accent-blue); padding: 0.35rem 0.75rem; font-size: 0.8125rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-md); display: inline-flex; align-items: center; gap: 0.25rem;">
                        View
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                      </a>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>

          <!-- Pagination Footer -->
          <% if (totalPages > 1) { %>
            <div style="padding: 1rem 1.5rem; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid var(--border-color); background: #fafafa; flex-wrap: wrap; gap: 0.75rem;">
              <span style="font-size: 0.8125rem; color: var(--text-muted);">
                Showing page <strong><%= page %></strong> of <strong><%= totalPages %></strong> (<%= total %> total leads)
              </span>

              <div style="display: flex; gap: 0.5rem;">
                <% if (page > 1) { %>
                  <a href="/admin/leads?page=<%= page - 1 %>" class="btn" style="background: #ffffff; border: 1px solid var(--border-color); color: #09090b; padding: 0.4rem 0.8rem; font-size: 0.8125rem; text-decoration: none;">
                    Previous
                  </a>
                <% } %>

                <% if (page < totalPages) { %>
                  <a href="/admin/leads?page=<%= page + 1 %>" class="btn" style="background: #ffffff; border: 1px solid var(--border-color); color: #09090b; padding: 0.4rem 0.8rem; font-size: 0.8125rem; text-decoration: none;">
                    Next
                  </a>
                <% } %>
              </div>
            </div>
          <% } %>
        <% } else { %>
          <div style="text-align: center; padding: 3.5rem 1.5rem; color: var(--text-muted);">
            <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 0.75rem; color: #a1a1aa;">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
              <circle cx="9" cy="7" r="4"></circle>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <p style="font-size: 0.9375rem; font-weight: 500; margin-bottom: 0.25rem; color: #09090b;">No leads captured yet</p>
            <p style="font-size: 0.8125rem;">Leads received via active WhatsApp channels will automatically appear here.</p>
          </div>
        <% } %>
      </div>
    </main>
  </div>
</body>
</html>

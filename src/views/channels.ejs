<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= appTitle %> - Channels</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    .badge-status {
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      padding: 0.2rem 0.55rem;
      border-radius: 9999px;
      font-size: 0.75rem;
      font-weight: 600;
      text-transform: capitalize;
    }
    .badge-status-active {
      background: var(--badge-success-bg);
      color: var(--badge-success-text);
    }
  </style>
</head>
<body>
  <%- include('partials/admin_sidebar') %>

  <div class="app-container">
    <main class="main-content admin-page-container">
      <!-- Top Action Bar -->
      <div class="admin-header-bar">
        <div class="admin-header-left">
          <button type="button" class="sidebar-toggle-btn" onclick="toggleAdminSidebar()" aria-label="Toggle Navigation Drawer" title="Toggle Sidebar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect width="18" height="18" x="3" y="3" rx="2"></rect>
              <line x1="9" y1="3" x2="9" y2="21"></line>
              <path d="m14 9 3 3-3 3"></path>
            </svg>
          </button>
          <div>
            <h1 class="admin-title">
              Channels
            </h1>
            <p class="admin-subtitle">
              Manage WhatsApp channels and their assigned pipelines.
            </p>
          </div>
        </div>

        <button onclick="document.getElementById('createChannelModal').style.display='flex'" class="btn" style="background: var(--accent-blue); color: #ffffff; padding: 0.55rem 1rem; font-size: 0.8125rem; font-weight: 600; border: none; border-radius: var(--radius-md); cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem; box-shadow: var(--shadow-sm);">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
          Create Channel
        </button>
      </div>

      <!-- Feedback Alerts -->
      <% if (notice === 'channel_created') { %>
        <div style="background: var(--badge-success-bg); color: var(--badge-success-text); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Channel created successfully.
        </div>
      <% } else if (notice === 'channel_deleted') { %>
        <div style="background: var(--badge-success-bg); color: var(--badge-success-text); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500; display: flex; align-items: center; gap: 0.5rem;">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
          Channel, WhatsApp session, and Google connection were successfully deleted.
        </div>
      <% } %>

      <% if (error === 'name_required') { %>
        <div style="background: var(--badge-danger-bg); color: var(--badge-danger-text); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500;">
          Channel name is required.
        </div>
      <% } else if (error === 'delete_failed') { %>
        <div style="background: var(--badge-danger-bg); color: var(--badge-danger-text); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500;">
          Failed to delete channel. Please try again.
        </div>
      <% } else if (error) { %>
        <div style="background: var(--badge-danger-bg); color: var(--badge-danger-text); padding: 0.75rem 1rem; border-radius: var(--radius-md); margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 500;">
          An error occurred. Please try again.
        </div>
      <% } %>

      <!-- Channels List -->
      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% if (channels && channels.length > 0) { %>
          <% channels.forEach(channel => { %>
            <div class="admin-card-row">
              <div style="display: flex; flex-direction: column; gap: 0.35rem; width: 100%;">
                <div style="display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap;">
                  <span style="font-size: 1.0625rem; font-weight: 600; color: #09090b;">
                    <%= channel.name %>
                  </span>
                  <span class="badge-status badge-status-active">
                    <%= channel.status %>
                  </span>
                </div>
                <div class="admin-meta-tags">
                  <span><strong>ID:</strong> <code style="background: var(--subtle-bg); padding: 0.1rem 0.35rem; border-radius: 4px; font-family: monospace; font-size: 0.8125rem;"><%= channel.id %></code></span>
                  <span><strong>Leads:</strong> <%= channel.lead_count || 0 %></span>
                  <span><strong>Created:</strong> <%= channel.created_at_formatted %></span>
                </div>
              </div>

              <div class="admin-actions-group">
                <a href="/app/<%= appSecret %>/channels/<%= channel.id %>" class="btn" style="background: #ffffff; color: var(--text-muted); border: 1px solid var(--border-color); padding: 0.45rem 0.75rem; font-size: 0.8125rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); transition: background 0.15s ease;">
                  Details
                </a>
                <a href="/app/<%= appSecret %>?channelId=<%= channel.id %>" class="btn" style="background: #09090b; color: #ffffff; padding: 0.45rem 0.9rem; font-size: 0.8125rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); display: inline-flex; align-items: center; gap: 0.35rem; transition: background 0.15s ease;">
                  Open
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
                <button type="button" class="btn btn-delete-channel" data-channel-id="<%= channel.id %>" data-channel-name="<%= channel.name %>" data-lead-count="<%= channel.lead_count || 0 %>" style="background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; padding: 0.45rem 0.75rem; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
                  Delete
                </button>
              </div>
            </div>
          <% }); %>
        <% } else { %>
          <div style="text-align: center; padding: 3rem 1.5rem; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); color: var(--text-muted);">
            No channels found.
          </div>
        <% } %>
      </div>
    </main>

    <!-- Create Channel Modal -->
    <div id="createChannelModal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.4); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 1.25rem; box-sizing: border-box;">
      <div style="background: #ffffff; width: 100%; max-width: 440px; border-radius: var(--radius-lg); padding: 1.75rem 1.5rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); border: 1px solid var(--border-color); box-sizing: border-box;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
          <h2 style="font-size: 1.15rem; font-weight: 700; color: #09090b; margin: 0;">
            Create Channel
          </h2>
          <button type="button" onclick="document.getElementById('createChannelModal').style.display='none'" style="background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0.25rem; display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <form action="/app/<%= appSecret %>/channels" method="POST">
          <div style="margin-bottom: 1.5rem;">
            <label for="channelNameInput" style="display: block; font-size: 0.8125rem; font-weight: 600; color: #09090b; margin-bottom: 0.4rem;">
              Channel Name
            </label>
            <input
              type="text"
              id="channelNameInput"
              name="name"
              placeholder="e.g. Sales Team WhatsApp"
              required
              autofocus
              style="width: 100%; padding: 0.65rem 0.85rem; border: 1px solid var(--border-color); border-radius: var(--radius-md); font-size: 0.875rem; font-family: inherit; color: var(--text-main); outline: none; box-sizing: border-box;"
            >
          </div>

          <div class="admin-form-actions" style="display: flex; justify-content: flex-end; gap: 0.75rem;">
            <button type="button" onclick="document.getElementById('createChannelModal').style.display='none'" class="btn" style="background: #ffffff; border: 1px solid var(--border-color); color: #09090b; padding: 0.55rem 0.9rem; font-size: 0.8125rem; font-weight: 500; border-radius: var(--radius-md); cursor: pointer; justify-content: center;">
              Cancel
            </button>
            <button type="submit" class="btn" style="background: var(--accent-blue); border: none; color: #ffffff; padding: 0.55rem 1rem; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; justify-content: center;">
              Create Channel
            </button>
          </div>
        </form>
      </div>
    </div>

    <!-- Backup All Leads & Delete Channel Modal -->
    <div id="deleteChannelModal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 1.25rem; box-sizing: border-box;">
      <div style="background: #ffffff; width: 100%; max-width: 480px; border-radius: var(--radius-lg); padding: 1.75rem 1.5rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); border: 1px solid var(--border-color); box-sizing: border-box;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 700; color: #09090b; margin: 0;">
              Backup all leads
            </h2>
          </div>
          <button type="button" onclick="closeDeleteChannelModal()" style="background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0.25rem; display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 1rem 0;">
          You are about to delete <strong id="deleteChannelName" style="color: #09090b;"></strong>.
        </p>

        <div style="background: #fef2f2; border: 1px solid #fee2e2; border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.25rem; font-size: 0.8125rem; color: #991b1b; line-height: 1.45;">
          <ul style="margin: 0; padding-left: 1.1rem;">
            <li>All associated <strong>WhatsApp</strong> and <strong>Google Sheets</strong> accounts will be immediately disconnected.</li>
            <li>Assigned operators will <strong>not be deleted</strong>; they will simply be unassigned and available for reassignment.</li>
            <li>Make sure to export all leads before permanently removing this channel.</li>
          </ul>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem;">
            <div>
              <div style="font-size: 0.8125rem; font-weight: 600; color: #09090b;">Export Leads to CSV</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><span id="deleteChannelLeadCount">0</span> total lead(s) captured</div>
            </div>
            <a id="exportLeadsBtn" href="#" class="btn" style="background: #ffffff; color: var(--accent-blue); border: 1px solid var(--border-color); font-size: 0.8125rem; font-weight: 600; text-decoration: none; padding: 0.45rem 0.85rem; border-radius: var(--radius-md); display: inline-flex; align-items: center; gap: 0.35rem; box-shadow: var(--shadow-sm);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Export CSV
            </a>
          </div>
        </div>

        <form id="deleteChannelForm" method="POST" action="">
          <div class="admin-form-actions" style="display: flex; justify-content: flex-end; gap: 0.75rem;">
            <button type="button" onclick="closeDeleteChannelModal()" class="btn" style="background: #ffffff; border: 1px solid var(--border-color); color: #09090b; padding: 0.55rem 0.9rem; font-size: 0.8125rem; font-weight: 500; border-radius: var(--radius-md); cursor: pointer;">
              Cancel
            </button>
            <button type="submit" class="btn" style="background: #dc2626; border: none; color: #ffffff; padding: 0.55rem 1.1rem; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
              Confirm Delete Channel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <script>
    function openDeleteChannelModal(channelId, channelName, leadCount) {
      document.getElementById('deleteChannelName').textContent = channelName + ' (' + channelId + ')';
      document.getElementById('deleteChannelLeadCount').textContent = leadCount;
      document.getElementById('exportLeadsBtn').href = '/app/<%= appSecret %>/channels/' + encodeURIComponent(channelId) + '/export-leads';
      document.getElementById('deleteChannelForm').action = '/app/<%= appSecret %>/channels/' + encodeURIComponent(channelId) + '/delete';
      document.getElementById('deleteChannelModal').style.display = 'flex';
    }

    function closeDeleteChannelModal() {
      document.getElementById('deleteChannelModal').style.display = 'none';
    }

    document.querySelectorAll('.btn-delete-channel').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-channel-id') || '';
        const name = btn.getAttribute('data-channel-name') || '';
        const leads = parseInt(btn.getAttribute('data-lead-count') || '0', 10);
        openDeleteChannelModal(id, name, leads);
      });
    });
  </script>
</body>
</html>

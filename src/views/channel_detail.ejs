<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= appTitle %> - <%= channel.name %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <main class="main-content" style="max-width: 700px; margin: 0 auto; width: 100%; padding: 2rem 1.25rem;">
      <!-- Navigation Back Link -->
      <div style="margin-bottom: 1.5rem;">
        <a href="/app/<%= appSecret %>/channels" class="btn" style="background: #ffffff; color: var(--text-muted); border: 1px solid var(--border-color); font-size: 0.8125rem; font-weight: 500; text-decoration: none; display: inline-flex; align-items: center; gap: 0.35rem; padding: 0.45rem 0.85rem; border-radius: var(--radius-md); box-shadow: var(--shadow-sm);">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back to Channels
        </a>
      </div>

      <!-- Channel Detail Card -->
      <div style="background: var(--bg-card); border: 1px solid var(--border-color); border-radius: var(--radius-lg); padding: 1.75rem 1.5rem; box-shadow: var(--shadow-sm);">
        <div class="admin-header-bar" style="margin-bottom: 1.5rem; border-bottom: 1px solid var(--border-color); padding-bottom: 1.25rem;">
          <div>
            <h1 class="admin-title">
              <%= channel.name %>
            </h1>
            <p class="admin-subtitle">
              Channel Details
            </p>
          </div>
          <div class="admin-actions-group">
            <span style="display: inline-flex; align-items: center; background: var(--badge-success-bg); color: var(--badge-success-text); padding: 0.25rem 0.65rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; text-transform: capitalize;">
              <%= channel.status %>
            </span>
            <a href="/app/<%= appSecret %>?channelId=<%= channel.id %>" class="btn" style="background: #09090b; color: #ffffff; padding: 0.5rem 1rem; font-size: 0.8125rem; font-weight: 500; text-decoration: none; border-radius: var(--radius-md); box-shadow: var(--shadow-sm); display: inline-flex; align-items: center; gap: 0.35rem; justify-content: center;">
              Open Lead Dashboard
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </a>
            <button type="button" onclick="document.getElementById('deleteChannelModal').style.display='flex'" class="btn" style="background: #fff1f2; color: #e11d48; border: 1px solid #fecdd3; padding: 0.5rem 0.9rem; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; display: inline-flex; align-items: center; gap: 0.35rem;">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>
              Delete Channel
            </button>
          </div>
        </div>

        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.75rem; border-bottom: 1px solid #f4f4f5; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Channel ID</span>
            <code style="background: var(--subtle-bg); padding: 0.2rem 0.5rem; border-radius: 4px; font-family: monospace; font-size: 0.875rem; color: #09090b; word-break: break-all;">
              <%= channel.id %>
            </code>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.75rem; border-bottom: 1px solid #f4f4f5; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Status</span>
            <span style="font-size: 0.875rem; font-weight: 600; color: #09090b; text-transform: capitalize;">
              <%= channel.status %>
            </span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; padding-bottom: 0.75rem; border-bottom: 1px solid #f4f4f5; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Total Leads</span>
            <span style="font-size: 0.875rem; font-weight: 600; color: #09090b;">
              <%= channel.lead_count %>
            </span>
          </div>

          <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem;">
            <span style="font-size: 0.875rem; color: var(--text-muted); font-weight: 500;">Created At</span>
            <span style="font-size: 0.875rem; color: #09090b;">
              <%= channel.created_at_formatted %>
            </span>
          </div>
        </div>
      </div>
    </main>

    <!-- Backup All Leads & Delete Channel Modal -->
    <div id="deleteChannelModal" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.45); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 1.25rem; box-sizing: border-box;">
      <div style="background: #ffffff; width: 100%; max-width: 480px; border-radius: var(--radius-lg); padding: 1.75rem 1.5rem; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1), 0 10px 10px -5px rgba(0,0,0,0.04); border: 1px solid var(--border-color); box-sizing: border-box;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
          <div style="display: flex; align-items: center; gap: 0.5rem;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: #fee2e2; color: #ef4444; display: flex; align-items: center; justify-content: center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
            </div>
            <h2 style="font-size: 1.15rem; font-weight: 700; color: #09090b; margin: 0;">
              Backup all leads
            </h2>
          </div>
          <button type="button" onclick="document.getElementById('deleteChannelModal').style.display='none'" style="background: none; border: none; cursor: pointer; color: var(--text-muted); padding: 0.25rem; display: flex; align-items: center; justify-content: center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
          </button>
        </div>

        <p style="font-size: 0.875rem; color: var(--text-muted); line-height: 1.5; margin: 0 0 1rem 0;">
          You are about to delete <strong style="color: #09090b;"><%= channel.name %> (<%= channel.id %>)</strong>.
        </p>

        <div style="background: #fef2f2; border: 1px solid #fee2e2; border-radius: var(--radius-md); padding: 0.85rem 1rem; margin-bottom: 1.25rem; font-size: 0.8125rem; color: #991b1b; line-height: 1.45;">
          <ul style="margin: 0; padding-left: 1.1rem;">
            <li>All associated <strong>WhatsApp</strong> and <strong>Google Sheets</strong> accounts will be immediately disconnected.</li>
            <li>Assigned operators will <strong>not be deleted</strong>; they will simply be unassigned and available for reassignment.</li>
            <li>Make sure to export all leads before permanently removing this channel.</li>
          </ul>
        </div>

        <div style="display: flex; flex-direction: column; gap: 0.75rem; margin-bottom: 1.5rem;">
          <div style="display: flex; align-items: center; justify-content: space-between; background: #f8fafc; border: 1px solid var(--border-color); border-radius: var(--radius-md); padding: 0.75rem 1rem;">
            <div>
              <div style="font-size: 0.8125rem; font-weight: 600; color: #09090b;">Export Leads to CSV</div>
              <div style="font-size: 0.75rem; color: var(--text-muted);"><%= channel.lead_count %> total lead(s) captured</div>
            </div>
            <a href="/app/<%= appSecret %>/channels/<%= channel.id %>/export-leads" class="btn" style="background: #ffffff; color: var(--accent-blue); border: 1px solid var(--border-color); font-size: 0.8125rem; font-weight: 600; text-decoration: none; padding: 0.45rem 0.85rem; border-radius: var(--radius-md); display: inline-flex; align-items: center; gap: 0.35rem; box-shadow: var(--shadow-sm);">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
              Export CSV
            </a>
          </div>
        </div>

        <form method="POST" action="/app/<%= appSecret %>/channels/<%= channel.id %>/delete">
          <div class="admin-form-actions" style="display: flex; justify-content: flex-end; gap: 0.75rem;">
            <button type="button" onclick="document.getElementById('deleteChannelModal').style.display='none'" class="btn" style="background: #ffffff; border: 1px solid var(--border-color); color: #09090b; padding: 0.55rem 0.9rem; font-size: 0.8125rem; font-weight: 500; border-radius: var(--radius-md); cursor: pointer;">
              Cancel
            </button>
            <button type="submit" class="btn" style="background: #dc2626; border: none; color: #ffffff; padding: 0.55rem 1.1rem; font-size: 0.8125rem; font-weight: 600; border-radius: var(--radius-md); cursor: pointer; display: inline-flex; align-items: center; gap: 0.4rem;">
              Confirm Delete Channel
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>
</html>
